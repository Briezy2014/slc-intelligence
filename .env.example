# SLC Intelligence local environment template
#
# Copy to `.env.local` for local development.
# Never commit real secrets, service-role keys, passwords, or student data.
# Values below are placeholders and safe descriptions only.

# Public application URL used for absolute links in development.
# Example: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Supabase project URL (public). Leave empty until Phase 3 authorization.
# Example shape only: https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (browser-safe when RLS is correctly configured).
# Never put the service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional node environment label for local tooling.
# Example: development
NODE_ENV=
