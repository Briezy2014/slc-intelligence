# SLC Intelligence local environment template
#
# Copy to `.env.local` for local development.
# Never commit real secrets, service-role keys, passwords, or student data.
# Values below are placeholders and safe descriptions only.

# Public product display name.
# Example: SLC Intelligence
NEXT_PUBLIC_APP_NAME=

# Public application URL used for absolute links and canonical metadata.
# Local example: http://localhost:3000
# Production example: https://slcintelligence.com
NEXT_PUBLIC_APP_URL=

# Supabase project URL (public browser configuration).
# Example shape only: https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (browser-safe only when RLS is correctly configured).
# Never put the service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side aliases for the same Supabase URL and anon key.
# These are not secrets and may match the NEXT_PUBLIC_* values above.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-only Supabase service-role key. When set, content libraries
# (interventions, accommodations, EF skills, communication templates) auto-fill
# for every active member. Without it, organization admins still auto-fill via
# their own session. Never put this in NEXT_PUBLIC_* variables.
# SUPABASE_SERVICE_ROLE_KEY=

# AI Assist kill switch (default enabled). Set to false to disable all AI Assist UI/actions.
AI_ASSIST_ENABLED=true
NEXT_PUBLIC_AI_ASSIST_ENABLED=true

# Optional model enrichment (OpenAI Platform API key — NOT a ChatGPT Plus login).
# Get sk-... from https://platform.openai.com/api-keys
# When unset, local drafts/visual packets still work. See docs/AI_API_KEY_SETUP.md
# Never commit real API keys.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional worksheet theme illustrations (OpenAI Images). SVG drawings always work without this.
AI_IMAGE_MODEL=gpt-image-1
